   "title": "一、选择题",
   "type": "choice",
   "questions": [
    {
     "id": "g2c-qlg-a-A1",
     "type": "choice",
     "stem": "《敕勒歌》是一首什么？",
     "options": [
      "北朝的民歌",
      "唐朝的律诗",
      "现代诗",
      "儿歌"
     ],
     "answer": "A",
     "why": "《敕勒歌》是南北朝时北方草原上流传的民歌。",
     "pts": 2
    },
    {
     "id": "g2c-qlg-a-A2",
     "type": "choice",
     "stem": "“天似穹庐”里，“穹庐”是什么？",
     "options": [
      "蒙古包一样的圆顶帐篷",
      "一座高山",
      "一条小河",
      "一间木屋"
     ],
     "answer": "A",
     "why": "“穹庐”就是草原上圆顶的毡帐（蒙古包），天空像它一样罩着大地。",
     "pts": 2
    },
    {
     "id": "g2c-qlg-a-A3",
     "type": "choice",
     "stem": "“天苍苍，野茫茫”写出了草原怎么样？",
     "options": [
      "天很蓝，原野很辽阔",
      "又小又挤",
      "很吵闹",
      "很黑暗"
     ],
     "answer": "A",
     "why": "“苍苍”是青色，“茫茫”是辽阔望不到边。",
     "pts": 2
    },
    {
     "id": "g2c-qlg-a-A4",
     "type": "choice",
     "stem": "“风吹草低见牛羊”是什么景象？",
     "options": [
      "风吹过，草伏下去，露出了牛羊",
      "风很小，草没动",
      "牛羊都跑了",
      "草地着火了"
     ],
     "answer": "A",
     "why": "草很高，风一吹草低下去，才看见藏在里面的牛羊。",
     "pts": 2
    }
   ]
