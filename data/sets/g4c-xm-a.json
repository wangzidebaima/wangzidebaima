   "type": "choice",
   "questions": [
    {
     "id": "g4c-xm-a-A1",
     "type": "choice",
     "stem": "“梅雪争春未肯降”中的“降”是什么意思？",
     "options": [
      "投降，服输",
      "降落",
      "下降",
      "降雨"
     ],
     "answer": "A",
     "why": "“降”读 xiáng，是“服输”的意思：梅花和雪都争着说春天是自己的，谁也不肯服输。",
     "pts": 2
    },
    {
     "id": "g4c-xm-a-A2",
     "type": "choice",
     "stem": "“骚人阁笔费评章”中的“骚人”指的是？",
     "options": [
      "诗人",
      "喜欢吵闹的人",
      "农夫",
      "将军"
     ],
     "answer": "A",
     "why": "“骚人”指诗人、文人。",
     "pts": 2
    },
    {
     "id": "g4c-xm-a-A3",
     "type": "choice",
     "stem": "“梅须逊雪三分白”的意思是？",
     "options": [
      "梅花在白色上要比雪差一些",
      "梅花比雪白三分",
      "梅花和雪一样白",
      "梅花的须是白的"
     ],
     "answer": "A",
     "why": "“逊”是“不如”的意思，梅花不如雪白。",
     "pts": 2
    },
    {
     "id": "g4c-xm-a-A4",
     "type": "choice",
     "stem": "“雪却输梅一段香”的意思是？",
     "options": [
      "雪没有梅花那么香",
      "雪比梅花香",
      "雪把梅花盖住了",
      "梅花被雪压坏了"
     ],
     "answer": "A",
     "why": "“输”是“比不上”，雪没有梅花香。",
     "pts": 2
    },
    {
     "id": "g4c-xm-a-A5",
     "type": "choice",
     "stem": "这首诗想告诉我们什么？",
     "options": [
      "每个事物都有自己的长处，也有不足，要互相学习",
      "梅花一定比雪好",
      "冬天比春天好",
      "写诗很难"
     ],
     "answer": "A",
     "why": "梅和雪各有所长：梅花不如雪白，雪不如梅花香，别人和自己都有长处和短处。",
     "pts": 2
    }
