    {
     "id": "g9mathk-2-A1",
     "type": "choice",
     "stem": "方程 x² − 5x + 6 = 0 的根是",
     "options": [
      "x₁ = −2，x₂ = −3",
      "x₁ = 1，x₂ = 6",
      "x₁ = 2，x₂ = 3",
      "x₁ = −1，x₂ = −6"
     ],
     "answer": "C",
     "why": "解析：(x − 2)(x − 3) = 0，所以 x = 2 或 x = 3。正确答案是“x₁ = 2，x₂ = 3”。",
     "pts": 2
    },
    {
     "id": "g9mathk-2-A2",
     "type": "choice",
     "stem": "方程 x² − 4x = 0 的根是",
     "options": [
      "x = 4",
      "x₁ = 0，x₂ = −4",
      "x = 0",
      "x₁ = 0，x₂ = 4"
     ],
     "answer": "D",
     "why": "解析：x(x − 4) = 0，x = 0 或 x = 4。正确答案是“x₁ = 0，x₂ = 4”。",
     "pts": 2
    },
    {
     "id": "g9mathk-2-A3",
     "type": "choice",
     "stem": "方程 x² + 2x − 3 = 0 的根的判别式 Δ 的值是",
     "options": [
      "16",
      "8",
      "−8",
      "4"
     ],
     "answer": "A",
     "why": "解析：Δ = b² − 4ac = 4 − 4 × 1 × (−3) = 16。",
     "pts": 2
    },
    {
     "id": "g9mathk-2-A4",
     "type": "choice",
     "stem": "若方程 x² − 6x + m = 0 有两个相等的实数根，则 m =",
     "options": [
      "6",
      "9",
      "3",
      "36"
     ],
     "answer": "B",
     "why": "解析：Δ = 36 − 4m = 0，m = 9。",
     "pts": 2
    },
    {
     "id": "g9mathk-2-A5",
     "type": "choice",
     "stem": "设 x₁、x₂ 是方程 x² − 3x + 1 = 0 的两根，则 x₁ + x₂ =",
     "options": [
      "−3",
      "1",
      "3",
      "2"
     ],
     "answer": "C",
     "why": "解析：由根与系数的关系，x₁ + x₂ = −b/a = 3。",
     "pts": 2
    }
