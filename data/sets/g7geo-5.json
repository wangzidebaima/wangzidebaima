    {
     "id": "g7geo-5-A2",
     "type": "choice",
     "stem": "等高线密集的地方，说明坡度",
     "options": [
      "缓",
      "平",
      "无法判断",
      "陡"
     ],
     "answer": "D",
     "why": "第5节：等高线越密，坡度越陡；越稀疏，坡度越缓。",
     "pts": 2
    },
    {
     "id": "g7geo-5-A3",
     "type": "choice",
     "stem": "海拔是指",
     "options": [
      "地面某点高出海平面的垂直距离",
      "两地之间的高度差",
      "山体的高度",
      "相对高度"
     ],
     "answer": "A",
     "why": "第5节：海拔又叫绝对高度，起点是海平面。",
     "pts": 2
    },
    {
     "id": "g7geo-5-A4",
     "type": "choice",
     "stem": "等高线向海拔较低处凸出，表示地形是",
     "options": [
      "山谷",
      "山脊",
      "盆地",
      "鞍部"
     ],
     "answer": "B",
     "why": "第5节：等高线向低处凸出是山脊，向高处凸出是山谷。",
     "pts": 2,
