"sentences": [
{
"id": "U6-s1",
"en": "Whose sweater is this, Mum?",
"zh": "这是谁的毛衣，妈妈？"
},
{
"id": "U6-s2",
"en": "It's your dad's.",
"zh": "是你爸爸的。"
},
{
"id": "U6-s3",
"en": "Can I wear this new shirt today?",
"zh": "我今天可以穿这件新衬衫吗？"
},
{
"id": "U6-s4",
"en": "Yes, but wear a coat too.",
"zh": "可以，但是再穿一件外套吧。"
},
{
"id": "U6-s5",
"en": "It's cold and windy outside.",
"zh": "外面有风，很冷。"
},
{
"id": "U6-s6",
"en": "Which season do you like?",
"zh": "你喜欢哪个季节？"
},
{
"id": "U6-s7",
"en": "Winter. It snows a lot.",
"zh": "冬天。冬天经常下雪。"
},
{
"id": "U6-s8",
"en": "I like winter too.",
"zh": "我也喜欢冬天。"
},
{
"id": "U6-s9",
"en": "There are many festivals.",
"zh": "（在冬天）有很多节日。"
},
{
"id": "U6-s10",
"en": "It's full of life.",
"zh": "（春天）充满生机。"
},
{
"id": "U6-s11",
"en": "And enjoy mooncakes.",
"zh": "还品尝月饼。"
},
{
"id": "U6-s12",
"en": "Then spring comes again.",
"zh": "接着春天又来了。"
}
]
